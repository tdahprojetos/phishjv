# Segredo usado para assinar os tokens de tracking (HMAC). TROQUE por um valor aleatório.
PHISHJV_SECRET=troque-este-segredo-por-algo-aleatorio-e-longo

# URL pública base onde o Phishjv está acessível aos alvos (pixel/clique/landing).
PHISHJV_BASE_URL=http://127.0.0.1:8000

# Banco de dados (SQLite por padrão).
PHISHJV_DATABASE_URL=sqlite:///./phishjv.db

# SMTP para envio das campanhas. Deixe SMTP_HOST vazio para modo "dry-run" (não envia, só registra).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@exemplo-interno.local
SMTP_STARTTLS=true
